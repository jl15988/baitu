{
  "name": "baitu",
  "private": false,
  "version": "1.1.8",
  "description": "A small and comprehensive front-end toolkit.",
  "type": "module",
  "main": "./dist/baitu.esm.js",
  "common": "./dist/baitu.cjs.js",
  "module": "./dist/baitu.esm.js",
  "browser": "./dist/baitu.browser.js",
  "unpkg": "./dist/baitu.browser.min.js",
  "jsdelivr": "./dist/baitu.browser.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/baitu.esm.js",
      "require": "./dist/baitu.cjs.js"
    },
    "./package": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "example": "webpack serve --config webpack.config.js --mode=development",
    "build": "rollup -c",
    "toPublish": "npm publish --registry=https://registry.npmjs.org --access=public"
  },
  "typings": "/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/jl15988/baitu.git"
  },
  "keywords": [
    "bai-tools",
    "jl15988",
    "baitu",
    "tool",
    "tools",
    "工具",
    "百图",
    "白图",
    "百涂"
  ],
  "author": "jl15988",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@types/crypto-js": "^4.2.2",
    "clean-webpack-plugin": "^4.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jsencrypt": "^3.3.2",
    "rollup": "^4.18.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "vitepress": "^1.2.3",
    "vue": "^3.4.21",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "js-md5": "^0.8.3",
    "long": "^5.2.3"
  }
}
