{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2016",
    "outDir": "lib",
    "declaration": true,
    "declarationDir": "types",
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
  ],
  "exclude": [
    "node_modules"
  ]
}
